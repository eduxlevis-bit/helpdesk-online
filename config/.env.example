# IT Helpdesk — secrets file
#
# HOW TO USE:
#   1. Copy this file to  .env  (same folder)   [rename .env.example -> .env]
#   2. Fill in the values below — this is the ONLY file you edit per server.
#   3. config/.htaccess blocks web access to this folder, so the file is
#      never readable from a browser. The deploy zip does NOT include .env.
#
# Lines starting with # are comments. Values may be quoted or unquoted.

# ── Database (from your host's control panel → MySQL Databases) ──────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=xxxx_it_helpdesk
MYSQL_USER=xxxx_it_user
MYSQL_PASS=your-database-password

# ── Mail ─────────────────────────────────────────────────────────────────────
# 'smtp' (recommended), 'mail' (PHP mail()) or 'off' (log only, send nothing)
MAIL_MODE=smtp
MAIL_FROM=you@gmail.com

# Gmail: use an App Password (myaccount.google.com → App passwords),
# NOT your normal Google password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=you@gmail.com
SMTP_PASS=your-gmail-app-password
